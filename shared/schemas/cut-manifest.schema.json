{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearplay.ai/schemas/cut-manifest-1.0.0.json",
  "title": "CutManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_id", "episode_id", "duration_ms", "manifest_version", "confidence", "segments"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "content_id": { "type": "string", "minLength": 1 },
    "episode_id": { "type": "string", "minLength": 1 },
    "season_number": { "type": ["integer", "null"], "minimum": 0 },
    "episode_number": { "type": ["integer", "null"], "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 1 },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string" },
    "status": { "enum": ["draft", "review", "verified", "rejected"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "start_ms", "end_ms", "confidence", "verification_status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["nudity", "sex", "violence", "graphic_violence", "language", "drugs", "alcohol", "disturbing"] },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": { "type": "string", "maxLength": 500 },
          "source": { "type": "string" },
          "verification_status": { "enum": ["unverified", "reviewed", "verified", "rejected"] }
        }
      }
    }
  }
}
