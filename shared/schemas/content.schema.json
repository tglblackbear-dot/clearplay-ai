{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearplay.ai/schemas/content-1.0.0.json",
  "title": "ContentIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": ["normalized_title", "content_type"],
  "properties": {
    "external_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "normalized_title": { "type": "string", "minLength": 1 },
    "content_type": { "enum": ["movie", "series"] },
    "release_year": { "type": ["integer", "null"], "minimum": 1800, "maximum": 2100 },
    "season_number": { "type": ["integer", "null"], "minimum": 0 },
    "episode_number": { "type": ["integer", "null"], "minimum": 0 },
    "streaming_service": { "type": "string" },
    "language": { "type": "string" },
    "duration_ms": { "type": ["integer", "null"], "minimum": 1 },
    "identification_method": { "enum": ["page_metadata", "structured_data", "external_catalog", "fingerprint", "manual"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
