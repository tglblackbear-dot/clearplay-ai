{
  "manifest_version": 3,
  "name": "ClearPlay AI",
  "version": "0.1.0",
  "description": "Filtragem discreta e configurável de cenas em players compatíveis.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "ClearPlay AI" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/player-detector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options/options.html"
}
